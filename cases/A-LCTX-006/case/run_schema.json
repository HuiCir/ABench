{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abench://run-schema/A-LCTX-006/v1",
  "title": "ABench A-LCTX-006 real run record",
  "description": "A benchmark-generated real artifact. Simulated and self-reported results are rejected.",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "provenance",
    "runner_version",
    "config_hash",
    "resource_hash",
    "artifact_hash",
    "metrics",
    "run_mode"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "const": "A-LCTX-006"
    },
    "provenance": {
      "enum": [
        "benchmark_real",
        "reference_real",
        "judge_real",
        "real"
      ]
    },
    "runner_version": {
      "type": "string",
      "minLength": 1
    },
    "config_hash": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"
    },
    "resource_hash": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"
    },
    "metrics": {
      "type": "object",
      "description": "Case-specific measured metrics; names and directions are defined in scoring_config/metric_registry.",
      "additionalProperties": true
    },
    "pareto": {
      "type": "object",
      "description": "Server-measured Pareto axes; unavailable values are null and excluded from dominance.",
      "required": [
        "quality",
        "throughput",
        "peak_memory",
        "compute_cost",
        "stability"
      ],
      "properties": {
        "quality": {
          "type": [
            "number",
            "null"
          ]
        },
        "throughput": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak_memory": {
          "type": [
            "number",
            "null"
          ]
        },
        "compute_cost": {
          "type": [
            "number",
            "null"
          ]
        },
        "stability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "hardware_signature": {
      "type": "object",
      "required": [
        "sandbox_profile",
        "hardware_class",
        "cost_unit"
      ],
      "properties": {
        "sandbox_profile": {
          "type": "string"
        },
        "hardware_class": {
          "type": "string"
        },
        "runtime_hash": {
          "type": "string"
        },
        "accelerator_count": {
          "type": "integer",
          "minimum": 0
        },
        "memory_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_unit": {
          "enum": [
            "GPU-h",
            "CPU-h",
            "H100-h"
          ]
        }
      },
      "additionalProperties": true
    },
    "setting": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "wall_time_ms": {
      "type": "number",
      "minimum": 0
    },
    "peak_memory_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Optional per-setting records for aggregate submissions."
    },
    "run_mode": {
      "const": "benchmark",
      "description": "Only benchmark-mode runs are scored; smoke runs (provenance smoke_real) are rejected."
    }
  },
  "additionalProperties": true
}
