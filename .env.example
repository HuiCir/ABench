# Environment for ./abench. Copy to `.env` (ignored by git and Docker builds) and fill in what you use:
#   cp .env.example .env
# ./abench reads `.env` at startup; variables already set in the shell take precedence. One NAME=value per line,
# taken literally (no ${VAR} expansion or inline comments); empty values are skipped. Keys reach an agent
# container only by variable name (docker -e NAME) and are never written to run records.

# Model API keys: the key_env names in spec/models.yaml
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=

# Upstream HTTP proxy for the egress sidecar, reachable from its Docker network
# (from rootless Docker the host is 10.0.2.2, e.g. http://10.0.2.2:<port>)
ABENCH_EGRESS_UPSTREAM=
