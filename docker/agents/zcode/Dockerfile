# Generated by tools/images.py; edit spec/env/images.yaml.
# zcode 3.15.1: the harness CLI is separate from the unchanged profile Python environment.
ARG PROFILE_IMAGE
FROM node:24.14.0-bookworm AS build
ENV COREPACK_ENABLE_PROJECT_SPEC=0 ELECTRON_SKIP_BINARY_DOWNLOAD=1 CI=1
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
RUN git clone --depth 1 --branch v3.15.1 https://github.com/zai-org/ZCode /src && test "$(git -C /src rev-parse HEAD)" = "aac4755666d09fdcd70272fcf063c077a639015f"
WORKDIR /src
RUN pnpm install --frozen-lockfile --filter "@zcode/cli..." && pnpm -r --filter "@zcode/cli..." run build
FROM node:24.14.0-bookworm-slim AS node
FROM ${PROFILE_IMAGE}
USER root
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=build /src/apps/zcode-cli/packages/cli/dist /opt/zcode
RUN rm -f /opt/zcode/*.map && printf '#!/bin/sh\nexec node /opt/zcode/zcode.cjs "$@"\n' > /usr/local/bin/zcode && chmod 755 /usr/local/bin/zcode
USER 1000:1000
