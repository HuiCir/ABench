FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS cuda
FROM ghcr.io/huicir/abench/gpu-torch:2026.10
USER root
COPY --from=cuda /usr/local/cuda /usr/local/cuda
ENV CUDA_HOME=/usr/local/cuda PATH=/usr/local/cuda/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends g++ && rm -rf /var/lib/apt/lists/*
COPY docker/profiles/gpu-torch-cuda-dev/requirements.lock /tmp/requirements.lock
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.lock
COPY tools/record_environment.py /abench/tools/record_environment.py
COPY tools/runtime/forwarder.py /abench/tools/forwarder.py
ENV HOME=/abench/workspace/.home TMPDIR=/abench/workspace/.tmp PYTHONDONTWRITEBYTECODE=1
USER 1000:1000
WORKDIR /abench/workspace
CMD ["sleep", "infinity"]
