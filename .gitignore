# run records, frozen data and secrets never go into the repository
/runs/
/sandbox/data/
/sandbox/hidden/
/sandbox/models/
/sandbox/judge_models/
/sandbox/.prepare/
*.key
*.enc
/.env
/.env.*
!/.env.example
/_to_delete/
# caches
__pycache__/
*.pyc
.ruff_cache/
.DS_Store
.pytest_cache/

# durable local job manifests and logs
/jobs/

# Host-specific image identities and lock-file synchronization stay local.
/spec/env/images.local.lock.yaml
/spec/env/.image-locks.lock
/exports/
