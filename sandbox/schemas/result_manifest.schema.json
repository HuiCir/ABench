{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abench://sandbox-result-manifest/v1",
  "title": "ABench retained result manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "case_id", "status", "provenance", "sandbox_manifest_sha256", "submission_sha256", "metrics", "compute", "artifacts", "cleanup"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "runner_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "status": {"enum": ["succeeded", "failed", "timeout", "oom", "cancelled", "cleanup_failed"]},
    "provenance": {"enum": ["smoke_real", "benchmark_real", "reference_real", "judge_real"]},
    "sandbox_manifest_sha256": {"$ref": "#/$defs/hash"},
    "submission_sha256": {"$ref": "#/$defs/hash"},
    "config_hash": {"$ref": "#/$defs/hash"},
    "resource_hash": {"$ref": "#/$defs/hash"},
    "metrics": {"type": "object", "additionalProperties": true},
    "harness": {"enum": ["command", "python", "claude"]},
    "model": {"type": ["string", "null"]},
    "effort": {"enum": ["low", "medium", "high", "xhigh", "max", null]},
    "permission_mode": {"enum": ["acceptEdits", "auto", "manual", "dontAsk", "plan", "bypassPermissions", null]},
    "control_plane_network": {"enum": ["none", "claude_api_endpoint_required"]},
    "compute": {
      "type": "object",
      "required": ["backend", "device", "wall_ms", "cpu_ms", "peak_ram_bytes", "peak_accelerator_bytes"],
      "properties": {
        "backend": {"enum": ["cpu", "cuda", "mps"]},
        "device": {"type": "string"},
        "wall_ms": {"type": "number", "minimum": 0},
        "cpu_ms": {"type": "number", "minimum": 0},
        "peak_ram_bytes": {"type": "integer", "minimum": 0},
        "peak_accelerator_bytes": {"type": ["integer", "null"], "minimum": 0},
        "fallback_ops": {"type": "array", "items": {"type": "string"}},
        "fallback_tracking": {"enum": ["observed", "best_effort", "unavailable", "not_applicable"]}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^(submission/|metrics\\.json$|run\\.jsonl$|telemetry/|hashes/|result_manifest\\.json$)"},
          "kind": {"enum": ["submission", "metrics", "run_log", "telemetry", "hashes", "manifest", "checkpoint_metadata"]},
          "sha256": {"$ref": "#/$defs/hash"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "failure": {
      "type": ["object", "null"],
      "properties": {
        "code": {"enum": ["manifest_invalid", "mount_failed", "network_violation", "filesystem_violation", "process_violation", "timeout", "oom", "nan_or_inf", "entrypoint_failed", "submission_invalid", "duplicate_submission", "attestation_failed", "cleanup_failed"]},
        "phase": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "signal": {"type": ["integer", "null"]}
      },
      "required": ["code", "phase"],
      "additionalProperties": false
    },
    "submission_validation": {
      "type": "object",
      "required": ["required", "missing"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "required_any_of": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "string"}}
        },
        "report_profile": {"type": ["string", "null"]},
        "missing": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": ["completed", "discarded", "checkpoint_bytes_retained"],
      "properties": {
        "completed": {"type": "boolean"},
        "discarded": {"type": "array", "items": {"type": "string"}},
        "checkpoint_bytes_retained": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"}
  },
  "additionalProperties": false
}
