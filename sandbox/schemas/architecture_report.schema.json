{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abench://architecture-report/v1",
  "title": "ABench machine-readable implementation report",
  "description": "A concise, auditable description of a submitted architecture and the evidence supporting its claims.",
  "type": "object",
  "required": ["schema_version", "case_id", "report_id", "architecture"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "architecture": {"$ref": "#/$defs/architecture"},
    "references": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"},
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"},
      "uniqueItems": true
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "additionalProperties": true,
  "$defs": {
    "architecture": {
      "type": "object",
      "required": ["paradigm", "components"],
      "properties": {
        "paradigm": {"type": "string", "minLength": 1},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/component"}
        },
        "data_flow": {
          "type": "array",
          "items": {"$ref": "#/$defs/dataFlow"}
        },
        "objectives": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "design_decisions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": ["id", "name", "role", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "trainable": {"type": ["boolean", "null"]},
        "implementation": {"type": "string"},
        "artifacts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "dataFlow": {
      "type": "object",
      "required": ["from", "to", "operation"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": ["id", "kind", "title", "locator"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "kind": {"enum": ["paper", "repository", "dataset", "model", "specification", "other"]},
        "title": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "sha256": {"$ref": "#/$defs/hash"},
        "claim": {"type": "string"},
        "accessed_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "claim"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "kind": {"enum": ["code", "config", "metric", "log", "artifact", "reference", "other"]},
        "claim": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "locator": {"type": "string"},
        "sha256": {"$ref": "#/$defs/hash"},
        "supports": {"type": "array", "items": {"type": "string"}},
        "verified": {"type": "boolean"}
      },
      "anyOf": [{"required": ["path"]}, {"required": ["locator"]}],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "author": {"type": "string"},
        "generated_at": {"type": "string"},
        "generator": {"type": "string"},
        "source_commit": {"type": "string"}
      },
      "additionalProperties": true
    },
    "hash": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"}
  }
}
