{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abench://data-provenance/v1",
  "title": "ABench data and model provenance registry",
  "type": "object",
  "required": ["schema_version", "case_id", "assets"],
  "properties": {
    "schema_version": {"const": "abench.data_provenance/v1"},
    "case_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "license", "snapshot", "sha256", "split", "fit_scope", "leakage_checks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "source": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "snapshot": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^(pending|(?:sha256:)?[0-9a-fA-F]{64})$"},
          "split": {"type": "string", "minLength": 1},
          "fit_scope": {"type": "string", "minLength": 1},
          "leakage_checks": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
