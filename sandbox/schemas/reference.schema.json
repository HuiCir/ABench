{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abench://reference/v1",
  "title": "ABench implementation reference",
  "type": "object",
  "required": ["id", "locator"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "kind": {"enum": ["paper", "repository", "dataset", "model", "specification", "other"]},
    "type": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "citation": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "year": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"},
    "snapshot": {"type": "object", "additionalProperties": true},
    "claim": {"type": "string"},
    "accessed_at": {"type": "string"}
  },
  "anyOf": [{"required": ["kind"]}, {"required": ["type"]}],
  "allOf": [{"anyOf": [{"required": ["title"]}, {"required": ["citation"]}]}],
  "additionalProperties": true
}
