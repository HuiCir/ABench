{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abench://submission-manifest/v1",
  "title": "ABench retained submission manifest",
  "type": "object",
  "required": ["schema_version", "case_id", "run_id", "submission_sha256", "files", "checkpoint_policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "submission_sha256": {"$ref": "#/$defs/hash"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes", "kind"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"$ref": "#/$defs/hash"},
          "bytes": {"type": "integer", "minimum": 0},
          "kind": {"enum": ["code", "config", "metrics", "model_manifest", "architecture_report", "evidence", "prediction", "documentation", "other"]}
        },
        "additionalProperties": false
      }
    },
    "checkpoint_policy": {"enum": ["ephemeral", "metadata_only", "promote_final"]},
    "final_checkpoint_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"}
  },
  "additionalProperties": false
}
