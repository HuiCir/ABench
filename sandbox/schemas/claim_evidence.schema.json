{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abench://claim-evidence/v1",
  "title": "ABench claim evidence",
  "type": "object",
  "anyOf": [
    {
      "required": ["id", "kind", "claim"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "kind": {"enum": ["code", "config", "metric", "log", "artifact", "reference", "other"]},
        "claim": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "locator": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"}
      }
    },
    {
      "required": ["claim_id", "claim", "evidence"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "claim": {"type": "string", "minLength": 1},
        "statement": {"type": "string"},
        "claim_type": {"type": "string"},
        "status": {"enum": ["pending", "partially_supported", "supported", "verified", "rejected"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
        "measurement": {"type": "string"}
      }
    }
  ],
  "additionalProperties": true
}
