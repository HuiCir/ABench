{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abench://evidence-manifest/v1",
  "title": "ABench evidence manifest",
  "type": "object",
  "required": ["schema_version", "case_id", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "claim"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "kind": {"enum": ["code", "config", "metric", "log", "artifact", "reference", "other"]},
          "claim": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
          "locator": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"},
          "supports": {"type": "array", "items": {"type": "string"}},
          "verified": {"type": "boolean"}
        },
        "anyOf": [{"required": ["path"]}, {"required": ["locator"]}],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
