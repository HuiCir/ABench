{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abench://report-manifest/v1",
  "title": "ABench report package manifest",
  "description": "Machine-readable index for an offline ABench design report and its evidence files.",
  "type": "object",
  "required": ["schema_version", "case_id", "report_id", "report_profile", "format", "required_sections", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "submission_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "report_profile": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "task_family": {"type": "string"},
    "objective_mode": {"enum": ["pareto", "gate", "judge", "diagnostic"]},
    "status": {"enum": ["draft", "submitted", "pending", "validated"]},
    "format": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "source": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "self_contained": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "required_sections": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "files": {
      "type": "object",
      "properties": {
        "report": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "report_html": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "report_markdown": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "references": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sources": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "evidence": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "data_provenance": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "claim_evidence": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "retrieval_log": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "kind": {"enum": ["code", "config", "data", "model", "result", "figure", "log", "other"]},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"},
          "used_by": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
