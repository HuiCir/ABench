{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abench://sandbox-manifest/v1",
  "title": "ABench sandbox manifest",
  "type": "object",
  "required": ["schema_version", "sandbox_id", "case_id", "run_id", "scoring", "harness", "data_assets", "model_assets", "compute", "workspace", "storage", "security"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sandbox_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "case_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "scoring": {"type": "boolean"},
    "purpose": {"type": "string"},
    "harness": {
      "type": "object",
      "required": ["kind", "entrypoint", "timeout_sec"],
      "properties": {
        "kind": {"enum": ["python", "shell", "container", "claude_code_cli", "claude_code_p"]},
        "entrypoint": {"type": ["string", "array"]},
        "args": {"type": "array", "items": {"type": "string"}},
        "binary": {"type": "string"},
        "python": {"type": "string"},
        "image": {"type": "string"},
        "prompt_file": {"type": "string"},
        "timeout_sec": {"type": "integer", "minimum": 1},
        "max_output_bytes": {"type": "integer", "minimum": 1},
        "env_allowlist": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["claude_code_cli", "claude_code_p"]}}}, "then": {"required": ["binary", "prompt_file"]}},
        {"if": {"properties": {"kind": {"const": "container"}}}, "then": {"required": ["image"]}}
      ]
    },
    "data_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "model_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/modelAsset"}
    },
    "compute": {
      "type": "object",
      "required": ["backend", "device", "scoring", "limits", "measurement"],
      "properties": {
        "backend": {"enum": ["cpu", "cuda", "mps"]},
        "device": {"type": "string", "pattern": "^(cpu|cuda(:[0-9]+)?|mps)$"},
        "fallback_backend": {"enum": ["cpu", "none"]},
        "scoring": {"type": "boolean"},
        "limits": {"$ref": "#/$defs/limits"},
        "measurement": {"$ref": "#/$defs/measurement"}
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": ["root", "read_write", "read_only", "forbidden", "checkpoint_dir", "submission_dir", "scratch_dir", "max_bytes"],
      "properties": {
        "root": {"type": "string"},
        "read_write": {"type": "array", "items": {"type": "string"}},
        "read_only": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}},
        "checkpoint_dir": {"type": "string"},
        "submission_dir": {"type": "string"},
        "scratch_dir": {"type": "string"},
        "max_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["input_mount_root", "result_sink", "artifact_policy", "submit"],
      "properties": {
        "input_mount_root": {"type": "string"},
        "result_sink": {"type": "string"},
        "artifact_policy": {"$ref": "#/$defs/artifactPolicy"},
        "submit": {"$ref": "#/$defs/submit"}
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": ["network", "process_allowlist", "hidden_inputs", "host_filesystem", "other_runs"],
      "properties": {
        "network": {"const": "disabled"},
        "process_allowlist": {"type": "array", "items": {"type": "string"}},
        "hidden_inputs": {"const": "inaccessible"},
        "host_filesystem": {"const": "inaccessible"},
        "other_runs": {"const": "inaccessible"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "uri", "mount", "sha256", "format", "split", "visibility", "read_only"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "uri": {"type": "string", "minLength": 1},
        "mount": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}|^TO_BE_FROZEN$"},
        "format": {"type": "string"},
        "split": {"type": "string"},
        "visibility": {"enum": ["public", "hidden", "server_only"]},
        "read_only": {"const": true}
      },
      "additionalProperties": false
    },
    "modelAsset": {
      "type": "object",
      "required": ["id", "uri", "mount", "sha256", "role", "read_only"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "uri": {"type": "string", "minLength": 1},
        "mount": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}|^TO_BE_FROZEN$"},
        "role": {"enum": ["base", "teacher", "student", "tokenizer", "processor", "adapter"]},
        "revision": {"type": "string"},
        "read_only": {"const": true}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["wall_ms", "cpu_threads", "ram_bytes", "accelerator_mem_bytes", "output_bytes"],
      "properties": {
        "wall_ms": {"type": "integer", "minimum": 1},
        "cpu_threads": {"type": "integer", "minimum": 1},
        "ram_bytes": {"type": "integer", "minimum": 1},
        "accelerator_mem_bytes": {"type": ["integer", "null"], "minimum": 1},
        "output_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["server_side", "warmup_steps", "synchronize", "record_unified_memory_peak", "record_fallback_ops"],
      "properties": {
        "server_side": {"const": true},
        "warmup_steps": {"type": "integer", "minimum": 0},
        "synchronize": {"type": "boolean"},
        "record_unified_memory_peak": {"type": "boolean"},
        "record_fallback_ops": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "artifactPolicy": {
      "type": "object",
      "required": ["retain", "retain_metadata_only", "discard", "checkpoint_bytes"],
      "properties": {
        "retain": {"type": "array", "items": {"type": "string"}},
        "retain_metadata_only": {"type": "array", "items": {"type": "string"}},
        "discard": {"type": "array", "items": {"type": "string"}},
        "checkpoint_bytes": {"enum": ["ephemeral", "promote_final"]}
      },
      "additionalProperties": false
    },
    "submit": {
      "type": "object",
      "required": ["once", "required_files", "max_submission_bytes"],
      "properties": {
        "once": {"const": true},
        "required_files": {"type": "array", "items": {"type": "string"}},
        "max_submission_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
